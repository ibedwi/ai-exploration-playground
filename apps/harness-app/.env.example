# Copy to .env and fill in. The server loads this via dotenv.
#
# DATABASE_URL       — Postgres for durable execution (DBOS). Use a Neon/other
#                      Postgres DIRECT connection string (not a -pooler host).
# ANTHROPIC_API_KEY  — optional. If unset, the harness runs a built-in MOCK
#                      model so the whole app works end-to-end with no key.
#                      Set it to use a real Claude model.
# MODEL              — optional. Defaults to claude-sonnet-4-6.
# PORT               — optional. Defaults to 8787.

DATABASE_URL=postgresql://user:password@host/harness?sslmode=require
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
PORT=8787
